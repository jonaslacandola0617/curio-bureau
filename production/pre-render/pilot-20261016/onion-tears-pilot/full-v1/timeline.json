  "captions": [
    {
      "start": 0.0,
      "end": 0.84,
      "text": "Cut here.",
      "word_start": 0,
      "word_end": 1
    },
    {
      "start": 1.3,
      "end": 2.2,
      "text": "Tear up here.",
      "word_start": 2,
      "word_end": 4
    },
    {
      "start": 2.82,
      "end": 4.154999999999999,
      "text": "How does an onion reach your",
      "word_start": 5,
      "word_end": 10
    },
    {
      "start": 4.18,
      "end": 4.66,
      "text": "eyes?",
      "word_start": 11,
      "word_end": 11
    },
    {
      "start": 5.27,
      "end": 7.2700000000000005,
      "text": "The knife damages the onion's tissue,",
      "word_start": 12,
      "word_end": 17
    },
    {
      "start": 7.57,
      "end": 9.33,
      "text": "starting a chain of chemical reactions.",
      "word_start": 18,
      "word_end": 23
    },
    {
      "start": 10.05,
      "end": 11.924999999999999,
      "text": "One step uses an enzyme called",
      "word_start": 24,
      "word_end": 29
    },
    {
      "start": 11.95,
      "end": 14.03,
      "text": "lachrymatory factor synthase.",
      "word_start": 30,
      "word_end": 32
    },
    {
      "start": 14.53,
      "end": 16.345000000000002,
      "text": "It helps make a volatile compound",
      "word_start": 33,
      "word_end": 38
    },
    {
      "start": 16.37,
      "end": 18.03,
      "text": "called the lachrymatory factor.",
      "word_start": 39,
      "word_end": 42
    },
    {
      "start": 18.73,
      "end": 20.305,
      "text": "Volatile means it can enter the",
      "word_start": 43,
      "word_end": 48
    },
    {
      "start": 20.33,
      "end": 20.71,
      "text": "air.",
      "word_start": 49,
      "word_end": 49
    },
    {
      "start": 21.41,
      "end": 23.745,
      "text": "That compound causes the familiar eye",
      "word_start": 50,
      "word_end": 55
    },
    {
      "start": 23.77,
      "end": 26.130000000000003,
      "text": "irritation associated with chopping onions.",
      "word_start": 56,
      "word_end": 60
    },
    {
      "start": 26.58,
      "end": 28.675,
      "text": "So the slice and the irritation",
      "word_start": 61,
      "word_end": 66
    },
    {
      "start": 28.7,
      "end": 30.44,
      "text": "happen in different places,",
      "word_start": 67,
      "word_end": 70
    },
    {
      "start": 30.78,
      "end": 32.68,
      "text": "connected by an airborne chemical.",
      "word_start": 71,
      "word_end": 75
    },
    {
      "start": 33.66,
      "end": 35.36,
      "text": "The knife never touched your eye,",
      "word_start": 76,
      "word_end": 81
    },
    {
      "start": 35.7,
      "end": 37.315000000000005,
      "text": "it started a reaction that could",
      "word_start": 82,
      "word_end": 87
    },
    {
      "start": 37.34,
      "end": 37.9,
      "text": "reach it.",
      "word_start": 88,
      "word_end": 89
    }
  ],
