  "captions": [
    {
      "start": 0.0,
      "end": 1.5499999999999998,
      "text": "You felt your phone vibrate.",
      "word_start": 0,
      "word_end": 4
    },
    {
      "start": 1.94,
      "end": 2.57,
      "text": "You checked it.",
      "word_start": 5,
      "word_end": 7
    },
    {
      "start": 3.0,
      "end": 3.4099999999999997,
      "text": "Nothing.",
      "word_start": 8,
      "word_end": 8
    },
    {
      "start": 4.02,
      "end": 6.01,
      "text": "So what did you actually feel?",
      "word_start": 9,
      "word_end": 14
    },
    {
      "start": 6.52,
      "end": 8.615,
      "text": "Sometimes the phone never vibrated at",
      "word_start": 15,
      "word_end": 20
    },
    {
      "start": 8.64,
      "end": 8.99,
      "text": "all.",
      "word_start": 21,
      "word_end": 21
    },
    {
      "start": 9.58,
      "end": 11.514999999999999,
      "text": "That experience is called a phantom",
      "word_start": 22,
      "word_end": 27
    },
    {
      "start": 11.54,
      "end": 12.21,
      "text": "vibration.",
      "word_start": 28,
      "word_end": 28
    },
    {
      "start": 13.12,
      "end": 15.435,
      "text": "One proposed explanation starts with what",
      "word_start": 29,
      "word_end": 34
    },
    {
      "start": 15.46,
      "end": 16.05,
      "text": "you expect.",
      "word_start": 35,
      "word_end": 36
    },
    {
      "start": 16.68,
      "end": 17.97,
      "text": "When you're waiting for a call,",
      "word_start": 37,
      "word_end": 42
    },
    {
      "start": 18.36,
      "end": 20.175,
      "text": "your brain may interpret another sensation",
      "word_start": 43,
      "word_end": 48
    },
    {
      "start": 20.2,
      "end": 21.73,
      "text": "as the familiar buzz.",
      "word_start": 49,
      "word_end": 52
    },
    {
      "start": 22.4,
      "end": 24.355,
      "text": "Pressure from clothing or a small",
      "word_start": 53,
      "word_end": 58
    },
    {
      "start": 24.38,
      "end": 26.349999999999998,
      "text": "muscle movement are possible candidates.",
      "word_start": 59,
      "word_end": 63
    },
    {
      "start": 26.9,
      "end": 29.295,
      "text": "But researchers haven't pinned down exactly",
      "word_start": 64,
      "word_end": 69
    },
    {
      "start": 29.32,
      "end": 30.689999999999998,
      "text": "what causes it.",
      "word_start": 70,
      "word_end": 72
    },
    {
      "start": 31.16,
      "end": 33.11,
      "text": "Surveys document the experience.",
      "word_start": 73,
      "word_end": 76
    },
    {
      "start": 33.58,
      "end": 34.89,
      "text": "They don't prove that mechanism.",
      "word_start": 77,
      "word_end": 81
    },
    {
      "start": 35.74,
      "end": 37.775,
      "text": "So a convincing buzz isn't always",
      "word_start": 82,
      "word_end": 87
    },
    {
      "start": 37.8,
      "end": 39.61,
      "text": "proof that your phone vibrated.",
      "word_start": 88,
      "word_end": 92
    },
    {
      "start": 40.12,
      "end": 41.63,
      "text": "The sensation can feel real,",
      "word_start": 93,
      "word_end": 97
    },
    {
      "start": 42.06,
      "end": 43.870000000000005,
      "text": "even when the alert wasn't.",
      "word_start": 98,
      "word_end": 102
    }
  ],
