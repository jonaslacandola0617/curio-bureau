  "captions": [
    {
      "start": 0.0,
      "end": 1.32,
      "text": "Imagine the sun vanished"
    },
    {
      "start": 1.32,
      "end": 2.57,
      "text": "right now."
    },
    {
      "start": 3.22,
      "end": 4.49,
      "text": "For about eight minutes,"
    },
    {
      "start": 4.8,
      "end": 5.83,
      "text": "you wouldn't know."
    },
    {
      "start": 6.56,
      "end": 8.35,
      "text": "This can't actually happen,"
    },
    {
      "start": 8.48,
      "end": 9.68,
      "text": "but the delay is"
    },
    {
      "start": 9.68,
      "end": 10.17,
      "text": "real."
    },
    {
      "start": 10.78,
      "end": 12.28,
      "text": "Sunlight takes about eight"
    },
    {
      "start": 12.28,
      "end": 13.54,
      "text": "minutes and 20 seconds"
    },
    {
      "start": 13.54,
      "end": 14.53,
      "text": "to reach Earth,"
    },
    {
      "start": 14.86,
      "end": 16.04,
      "text": "so the light arriving"
    },
    {
      "start": 16.04,
      "end": 17.54,
      "text": "now left the sun"
    },
    {
      "start": 17.54,
      "end": 18.51,
      "text": "minutes ago."
    },
    {
      "start": 19.04,
      "end": 20.5,
      "text": "Remove the source, and"
    },
    {
      "start": 20.5,
      "end": 21.84,
      "text": "that last light still"
    },
    {
      "start": 21.84,
      "end": 23.31,
      "text": "has distance to cross."
    },
    {
      "start": 23.96,
      "end": 25.59,
      "text": "Then, daylight ends."
    },
    {
      "start": 26.3,
      "end": 27.38,
      "text": "Here's the stranger part."
    },
    {
      "start": 27.38,
      "end": 29.25,
      "text": "In this thought experiment,"
    },
    {
      "start": 29.48,
      "end": 30.88,
      "text": "Earth's orbit wouldn't change"
    },
    {
      "start": 30.88,
      "end": 32.11,
      "text": "immediately either."
    },
    {
      "start": 32.52,
      "end": 33.84,
      "text": "Changes in gravity also"
    },
    {
      "start": 33.84,
      "end": 35.16,
      "text": "propagate at the speed"
    },
    {
      "start": 35.16,
      "end": 35.71,
      "text": "of light."
    },
    {
      "start": 36.4,
      "end": 37.65,
      "text": "Once that change arrived,"
    },
    {
      "start": 37.98,
      "end": 38.92,
      "text": "Earth would leave its"
    },
    {
      "start": 38.92,
      "end": 40.17,
      "text": "old solar orbit."
    },
    {
      "start": 40.8,
      "end": 41.92,
      "text": "So our first warning"
    },
    {
      "start": 41.92,
      "end": 43.03,
      "text": "wouldn't be instant."
    },
    {
      "start": 43.62,
      "end": 44.66,
      "text": "We'd spend those final"
    },
    {
      "start": 44.66,
      "end": 46.24,
      "text": "minutes living in the"
    },
    {
      "start": 46.24,
      "end": 47.27,
      "text": "sun's past."
    }
  ],
