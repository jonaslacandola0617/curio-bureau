  "segments": [
    {
      "start": 0.0,
      "end": 2.42,
      "text": " Imagine the sun vanished right now."
    },
    {
      "start": 3.22,
      "end": 5.7,
      "text": " For about eight minutes, you wouldn't know."
    },
    {
      "start": 6.54,
      "end": 10.02,
      "text": " This can't actually happen, but the delay is real."
    },
    {
      "start": 10.78,
      "end": 14.38,
      "text": " Sunlight takes about eight minutes and 20 seconds to reach Earth,"
    },
    {
      "start": 14.7,
      "end": 18.36,
      "text": " so the light arriving now left the sun minutes ago."
    },
    {
      "start": 19.08,
      "end": 23.16,
      "text": " Remove the source, and that last light still has distance to cross."
    },
    {
      "start": 23.96,
      "end": 25.48,
      "text": " Then, daylight ends."
    },
    {
      "start": 26.52,
      "end": 28.02,
      "text": " Here's the stranger part."
    },
    {
      "start": 28.74,
      "end": 32.6,
      "text": " In this thought experiment, Earth's orbit wouldn't change immediately either."
    },
    {
      "start": 33.2,
      "end": 36.2,
      "text": " Changes in gravity also propagate at the speed of light."
    },
    {
      "start": 37.02,
      "end": 40.68,
      "text": " Once that change arrived, Earth would leave its old solar orbit."
    },
    {
      "start": 41.46,
      "end": 43.54,
      "text": " So our first warning wouldn't be instant."
    },
    {
      "start": 44.26,
      "end": 47.76,
      "text": " We'd spend those final minutes living in the sun's past."
    }
  ]
}
